    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Linux) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/debug/ekhosTests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Tests",
        },
        {
            "name": "(Linux) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/bin/debug/ekhosTests",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
        },
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/debug/ekhosTests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Tests",
            "internalConsoleOptions": "openOnFirstSessionStart",
        },
        {
            "name": "(Linux) Benchmark",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/ekhosTests",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build Benchmark",
        },
        {
            "name": "(Windows) Benchmark",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/ekhosTests.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "Build Benchmark",
            "internalConsoleOptions": "openOnFirstSessionStart",
        },
        {
            "name": "(Windows) Attach",
            "type": "cppvsdbg",
            "request": "attach",
        },
        {
            "name": "Debug Builder",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "build.exe",
            "cwd": "${workspaceFolder}",
            "args": [
                "-test",
                "-debug",
                "-matlab",
                "-no-break",
            ],
            "preLaunchTask": "Build Builder",
            "stopAtEntry": false,
        },
    ]
}
